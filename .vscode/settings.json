{
  "jest.rootPath": ".",

  // Configures how tests are run automatically.
  // This setting will run all tests once on startup and then only re-run tests on file changes.
  // It's more stable than the default full watch mode which can sometimes cause issues.
  "jest.runMode": {
    "type": "watch",
    "onStartup": "none"
  },
  "testing.automaticallyOpenTestResults": "neverOpen"
}
