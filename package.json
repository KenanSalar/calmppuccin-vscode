              "default": "none",
              "description": "Set the font style for numbers and constants.",
              "enum": [
                "none",
                "italic",
                "bold",
                "italic bold",
                "underline"
              ]
            },
            "operatorFontStyle": {
              "type": "string",
              "default": "none",
              "description": "Set the font style for operators.",
              "enum": [
                "none",
                "italic",
                "bold",
                "italic bold",
                "underline"
              ]
            },
            "operatorOverloadFontStyle": {
