                },
                "extensionMethod": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for extension methods."
                },
                "delegate": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for delegates."
                },
                "event": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for events."
                },
                "parameter": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for parameters."
                },
