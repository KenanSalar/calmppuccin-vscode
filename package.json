  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --watch",
    "build-themes": "npm run compile && node ./dist/build.js",
    "package": "npm run build-themes && npx vsce package --no-dependencies",
    "publish:ci": "npm run build-themes && npx vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
