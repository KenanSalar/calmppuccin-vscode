                  "type": "string",
                  "pattern": "^#([A-Fa-f0-9]{6})$",
                  "patternErrorMessage": "Please enter a valid 6-digit hex color code (e.g., #RRGGBB).",
                  "description": "Overrides the color for the crust background."
                }
              }
            }
          }
        },
