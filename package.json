{
  "name": "calmppuccin-vscode",
  "displayName": "Calmppuccin",
  "description": "Calmppuccin is a visually refined theme for Visual Studio Code, designed to offer a harmonious coding experience. Inspired by the popular Catppuccin theme, Calmppuccin takes the beloved pastel palette and transforms it into a gentler, less intense version, perfect for long coding sessions without eye strain.",
  "icon": "assets/images/logo/icon.png",
  "version": "1.4.1",
  "publisher": "kenan-salar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KenanSalar/calmppuccin-vscode.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "calmppuccin",
    "catppuccin",
    "oledppuccin",
    "oledppuccin theme",
    "nitro cold brew",
    "nitro cold brew theme",
    "mocha",
    "mocha theme",
    "macchiato",
    "macchiato theme",
    "frappé",
    "frappé theme",
    "latte",
    "latte theme",
    "rosewater",
    "flamingo",
    "pink",
    "mauve",
    "red",
    "maroon",
    "peach",
    "yellow",
    "green",
    "teal",
    "sky",
    "sapphire",
    "blue",
    "lavender",
    "theme",
    "dark",
    "light",
    "color",
    "color theme",
    "syntax",
    "highlighting",
    "syntax highlighting",
    "syntax highlighting theme",
    "dark theme",
    "light theme",
    "readable",
    "relaxing",
    "relaxing theme"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Calmppuccin Macchiato",
        "uiTheme": "vs-dark",
        "path": "./themes/calmppuccin-macchiato-color-theme.json"
      },
      {
        "label": "Calmppuccin Mocha",
        "uiTheme": "vs-dark",
        "path": "./themes/calmppuccin-mocha-color-theme.json"
      },
      {
        "label": "Calmppuccin Nitro Cold Brew",
        "uiTheme": "vs-dark",
        "path": "./themes/calmppuccin-nitro-cold-brew-color-theme.json"
      },
      {
        "label": "Calmppuccin Oledppuccin",
        "uiTheme": "vs-dark",
        "path": "./themes/calmppuccin-oledppuccin-color-theme.json"
      },
      {
        "label": "Calmppuccin Frappé",
        "uiTheme": "vs-dark",
        "path": "./themes/calmppuccin-frappe-color-theme.json"
      },
      {
        "label": "Calmppuccin Latte",
        "uiTheme": "vs",
        "path": "./themes/calmppuccin-latte-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Calmppuccin",
      "properties": {
        "calmppuccin.accent": {
          "type": "string",
          "default": "sapphire",
          "description": "The accent color for all Calmppuccin themes.",
          "enum": [
            "rosewater",
            "flamingo",
            "pink",
            "mauve",
            "red",
            "maroon",
            "peach",
            "yellow",
            "green",
            "teal",
            "sky",
            "sapphire",
            "blue",
            "lavender"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --watch",
    "build-themes": "node ./dist/build.js",
    "package": "npm run build-themes && vsce package --no-dependencies",
    "publish:ci": "npm run build-themes && vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.2.0",
    "@types/vscode": "^1.102.0",
    "fs-extra": "^11.2.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  }
}