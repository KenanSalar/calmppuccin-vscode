              "default": "italic",
              "description": "Set the font style for namespace attributes.",
              "enum": [
                "none",
                "italic",
                "bold",
                "italic bold",
                "underline"
              ]
            },
            "moduleFontStyle": {
              "type": "string",
              "default": "none",
              "description": "Set the font style for modules.",
              "enum": [
                "none",
                "italic",
                "bold",
                "italic bold",
                "underline"
              ]
            },
            "annotationFontStyle": {
              "type": "string",
              "default": "italic",
              "description": "Set the font style for annotations.",
              "enum": [
                "none",
                "italic",
                "bold",
                "italic bold",
                "underline"
              ]
            },
            "classFontStyle": {
              "type": "string",
              "default": "none",
              "description": "Set the font style for classes.",
              "enum": [
                "none",
                "italic",
                "bold",
                "italic bold",
                "underline"
              ]
            },
            "interfaceFontStyle": {
