                "enum": [
                  "none",
                  "italic",
                  "bold",
                  "italic bold",
                  "underline"
                ]
              }
            }
          }
        },
        "calmppuccin.profiles": {
          "type": "object",
          "default": {
            "Default": {}
          },
          "description": "Custom profiles to save different configuration sets. Each profile can contain its own accent, font styles, syntax overrides, and UI overrides.",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "description": "A custom profile containing theme configuration",
              "properties": {
