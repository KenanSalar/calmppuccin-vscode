        "calmppuccin.syntaxOverrides": {
          "type": "object",
          "default": {},
          "description": "Override specific syntax colors for each Calmppuccin flavor. Use the Customization UI for a better experience.",
          "patternProperties": {
            "^(latte|frappe|macchiato|mocha|nitro-cold-brew|oledppuccin)$": {
              "type": "object",
              "properties": {
                "comment": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for comments."
                },
                "variable": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for variables."
                },
                "keyword": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for keywords."
                },
                "namespace": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for namespaces."
                },
                "namespaceAttribute": {
                  "type": "string",
                  "format": "color-hex",
