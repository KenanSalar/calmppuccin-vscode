                },
                "fieldAndAttribute": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for fields and attributes."
                },
                "attributeBracket": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for attribute brackets."
                },
                "property": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for properties."
                },
                "propertyReadOnly": {
                  "type": "string",
                  "format": "color-hex",
                  "description": "Overrides the color for read-only properties."
                },
                "functionAndMethod": {
                  "type": "string",
                  "format": "color-hex",
