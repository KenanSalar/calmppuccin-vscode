{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": { "partitionByNewline": true, "newlinesBetween": false },
  // The sorter doesn't know VS Code manifest fields and moves `engines` below `contributes`.
  "sortPackageJson": false,
  // `npm run update-vscode-colors` writes workbenchColors.json expanded, which this would collapse
  // wherever an array fits on one line.
  "ignorePatterns": ["**/*.md", "test/__fixtures__/workbenchColors.json"]
}
